# CodeGraph SCIP-refresh systemd service template (Linux).
#
# Pair with codegraph-scip-refresh.timer (see systemd.timer.template).
# The service defines WHAT to run; the timer defines WHEN.
#
# HOW TO INSTALL (user-mode — no sudo required, runs as your user)
#   1. Copy this file to ~/.config/systemd/user/codegraph-scip-refresh.service
#      and the timer template to ~/.config/systemd/user/codegraph-scip-refresh.timer
#   2. Replace TWO placeholders in this file:
#        REPLACE_WITH_CODEGRAPH   →  $(which codegraph)   e.g. /usr/local/bin/codegraph
#        REPLACE_WITH_PROJECT     →  absolute path to your project root
#   3. Reload systemd-user:
#        systemctl --user daemon-reload
#   4. Enable + start the timer:
#        systemctl --user enable --now codegraph-scip-refresh.timer
#   5. Verify next run:
#        systemctl --user list-timers codegraph-scip-refresh
#
# HOW TO INSTALL (system-mode — requires sudo, runs as root or as User= below)
#   1. Copy to /etc/systemd/system/codegraph-scip-refresh.service
#   2. Add a `User=youruser` line under [Service] below (uncommented).
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now codegraph-scip-refresh.timer
#
# HOW TO UNINSTALL
#   systemctl --user disable --now codegraph-scip-refresh.timer
#   rm ~/.config/systemd/user/codegraph-scip-refresh.{service,timer}
#   systemctl --user daemon-reload
#
# LOGS
#   Per-run output:  <PROJECT>/.codegraph/logs/scip-refresh-<timestamp>.log
#   Sidecar:         <PROJECT>/.codegraph/scip-last-refresh.json
#   journald (systemd's own log): journalctl --user -u codegraph-scip-refresh -e
#
# EXIT CODES (per design § P2.3)
#   0 = ok, 1 = indexer failed, 2 = ingest failed (incl. post-ingest assertion)
#
# Non-zero exits surface as "failed" in `systemctl --user status`; journald
# captures stderr for diagnostics.

[Unit]
Description=CodeGraph SCIP refresh (regenerate compiler-grade index)
Documentation=https://github.com/colbymchenry/codegraph
# Avoid races with manual invocations.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=REPLACE_WITH_PROJECT
ExecStart=REPLACE_WITH_CODEGRAPH scip-refresh --quiet REPLACE_WITH_PROJECT

# Uncomment for system-mode install (running as a specific user):
# User=youruser

# Cap memory + CPU so the refresh doesn't starve interactive work.
# Adjust for your repo size — scip-dotnet can need 2-4 GB on large solutions.
MemoryMax=4G
CPUQuota=50%

# Best-effort scheduling so daytime workloads aren't impacted by an
# overlapping refresh.
Nice=10
IOSchedulingClass=idle

# Avoid an aborted run leaving a half-acquired lock; codegraph handles
# its own mutex, but the systemd-level timeout is a safety net.
TimeoutStartSec=30min

[Install]
WantedBy=default.target
